# Neon. `neon link` / `neon env pull` escribe normalmente DATABASE_URL en .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Acceso privado al dashboard. Si falta uno de los dos valores, el login se omite.
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
